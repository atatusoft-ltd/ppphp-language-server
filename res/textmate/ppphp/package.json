{
  "name": "ppphp-language",
  "displayName": "++PHP Language Basics",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "ppphp",
        "aliases": [
          "++PHP",
          "PPPHP"
        ],
        "extensions": [
          ".ppp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ppphp",
        "scopeName": "source.ppphp",
        "path": "./syntaxes/ppphp.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.php": "php"
        }
      }
    ]
  }
}
