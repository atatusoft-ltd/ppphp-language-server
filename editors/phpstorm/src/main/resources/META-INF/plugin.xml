<idea-plugin require-restart="true">
    <id>com.atatusoft.ppphp</id>
    <name>++PHP</name>
    <vendor>Atatusoft</vendor>

    <description><![CDATA[
        Syntax highlighting and Language Server Protocol support for ++PHP (.ppp) files.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="++PHP" implementationClass="com.atatusoft.ppphp.PpphpFileType" fieldName="INSTANCE" language="++PHP" extensions="ppp" />
        <lang.syntaxHighlighterFactory language="++PHP" implementationClass="com.atatusoft.ppphp.PpphpSyntaxHighlighterFactory" />
        <highlightErrorFilter implementation="com.atatusoft.ppphp.PpphpSyntaxErrorFilter" />
        <platform.lsp.integrationProvider implementation="com.atatusoft.ppphp.PpphpLspIntegrationProvider" />
        <directoryIndexExcludePolicy implementation="com.atatusoft.ppphp.PpphpCompilerDirectoriesExcludePolicy" />
        <postStartupActivity implementation="com.atatusoft.ppphp.PpphpProjectActivity" />
    </extensions>
</idea-plugin>
