<idea-plugin require-restart="true">
    <id>com.atatusoft.ppphp</id>
    <name>++PHP</name>
    <vendor>Atatusoft</vendor>

    <description><![CDATA[
        Syntax highlighting and Language Server Protocol support for ++PHP (.ppp) files.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.integrationProvider implementation="com.atatusoft.ppphp.PpphpLspIntegrationProvider" />
        <textmate.bundleProvider implementation="com.atatusoft.ppphp.PpphpTextMateBundleProvider" />
        <fileIconProvider implementation="com.atatusoft.ppphp.PpphpFileIconProvider" />
    </extensions>
</idea-plugin>
