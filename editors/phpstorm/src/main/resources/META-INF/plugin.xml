<idea-plugin require-restart="true">
    <id>com.atatusoft.ppphp</id>
    <name>++PHP</name>
    <vendor>Atatusoft</vendor>

    <description><![CDATA[
        <p>Language support for ++PHP, a superset of PHP that compiles to PHP.
        Edit .ppphp files alongside your existing PHP code in PhpStorm.</p>
        <ul>
            <li>Familiar highlighting, deterministic type completion, and automatic imports.</li>
            <li>Live compiler diagnostics, code navigation, and class-family rename refactoring.</li>
            <li>Native file and class creation with namespace and parent-type suggestions.</li>
            <li>Independent code-style settings, formatting, and PHPDoc comment scaffolding.</li>
            <li>PHP navigation to declarations compiled from ++PHP in mixed projects.</li>
        </ul>
        <p>The language server is bundled; a local Node.js runtime and the ++PHP compiler
        are required separately. Formatting does not yet have complete PHP parity.</p>
        <p><a href="https://github.com/atatusoft-ltd/ppphp-language-server/blob/main/editors/phpstorm/README.md">Setup, features, and support</a></p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>
    <depends>com.jetbrains.php</depends>
    <depends optional="true" config-file="ppphp-lsp.xml">com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="++PHP" implementationClass="com.atatusoft.ppphp.PpphpFileType" fieldName="INSTANCE" language="++PHP" extensions="ppphp" />
        <lang.syntaxHighlighterFactory language="++PHP" implementationClass="com.atatusoft.ppphp.PpphpSyntaxHighlighterFactory" />
        <lang.parserDefinition language="++PHP" implementationClass="com.atatusoft.ppphp.PpphpParserDefinition" />
        <lang.commenter language="++PHP" implementationClass="com.atatusoft.ppphp.PpphpCommenter" />
        <enterHandlerDelegate implementation="com.atatusoft.ppphp.PpphpDocumentationEnterHandler" />
        <langCodeStyleSettingsProvider
            implementation="com.atatusoft.ppphp.PpphpLanguageCodeStyleSettingsProvider" />
        <lang.formatter
            language="++PHP"
            implementationClass="com.atatusoft.ppphp.PpphpFormattingModelBuilder" />
        <internalFileTemplate name="++PHP File" />
        <internalFileTemplate name="++PHP Class" />
        <internalFileTemplate name="++PHP Interface" />
        <internalFileTemplate name="++PHP Trait" />
        <internalFileTemplate name="++PHP Enum" />
        <directoryIndexExcludePolicy implementation="com.atatusoft.ppphp.PpphpCompilerDirectoriesExcludePolicy" />
        <additionalLibraryRootsProvider implementation="com.atatusoft.ppphp.PpphpGeneratedPhpLibraryProvider" />
        <postStartupActivity implementation="com.atatusoft.ppphp.PpphpProjectActivity" />
        <renameHandler implementation="com.atatusoft.ppphp.PpphpRenameHandler" order="first" />
    </extensions>

    <actions>
        <action
            id="com.atatusoft.ppphp.actions.PpphpCreateFileAction"
            class="com.atatusoft.ppphp.PpphpCreateFileAction"
            text="++PHP File"
            description="Create an empty ++PHP source file"
            icon="/icons/ppphp.svg">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile" />
        </action>
        <action
            id="com.atatusoft.ppphp.actions.PpphpCreateClassAction"
            class="com.atatusoft.ppphp.PpphpCreateClassAction"
            text="++PHP Class"
            description="Create a ++PHP class, interface, trait, or enum"
            icon="/icons/ppphp.svg">
            <add-to-group
                group-id="NewGroup"
                anchor="after"
                relative-to-action="com.atatusoft.ppphp.actions.PpphpCreateFileAction" />
        </action>
    </actions>
</idea-plugin>
